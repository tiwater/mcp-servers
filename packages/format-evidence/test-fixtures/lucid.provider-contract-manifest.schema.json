                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "resourceKey",
                    "access"
                  ],
                  "properties": {
                    "resourceKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "access": {
                      "enum": [
                        "read",
                        "shared-write",
                        "exclusive-write"
                      ]
                    }
                  }
                },
                "minItems": 1
              },
              "sideEffect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "idempotent"
                ],
                "properties": {
                  "kind": {
                    "const": "read-only"
                  },
                  "idempotent": {
                    "type": "boolean"
                  }
                }
              },
              "attemptBudget": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "unique-by:kind within one manifest; enforced by manifest validator"
          },
