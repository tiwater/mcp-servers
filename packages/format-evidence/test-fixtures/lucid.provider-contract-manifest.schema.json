                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "requestSchema": {
                "type": "string",
                "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
              },
              "validatorRequestSchema": {
                "type": "string",
                "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
