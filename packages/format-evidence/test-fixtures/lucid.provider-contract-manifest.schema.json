{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.provider-contract-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaSetVersion",
    "manifestId",
    "provider",
    "runtime",
    "ports"
  ],
  "properties": {
    "schema": {
      "const": "lucid.provider-contract-manifest"
    },
    "schemaSetVersion": {
      "const": 15
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
