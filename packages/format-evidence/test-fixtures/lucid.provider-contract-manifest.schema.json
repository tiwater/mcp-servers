      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "producer",
              "validator",
              "requestSchema",
              "validatorRequestSchema",
              "resultSchema",
              "verdictSchema",
              "options",
              "cacheKeyComposition",
              "resourceDeclarations",
              "sideEffect",
              "attemptBudget"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "observe",
                  "derive",
                  "reobserve",
                  "render"
                ]
              },
              "producer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "adapterIdentity"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adapterIdentity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "version"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "validator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "adapterIdentity"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adapterIdentity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "version"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "requestSchema": {
                "type": "string",
                "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
              },
              "validatorRequestSchema": {
                "type": "string",
                "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
              },
              "resultSchema": {
                "type": "string",
                "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
              },
              "verdictSchema": {
                "type": "string",
                "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "valueSchema"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "valueSchema": {
                      "type": "string",
                      "pattern": "^(lucid\\.[a-z0-9-]+(/v[0-9]+)?|tiwater\\.[a-z0-9-]+/v[0-9]+)$"
                    }
                  }
                }
              },
              "cacheKeyComposition": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "resourceDeclarations": {
                "type": "array",
