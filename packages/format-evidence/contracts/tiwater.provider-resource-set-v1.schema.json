{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.provider-resource-set/v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["resourceKey", "access"],
    "properties": {
      "resourceKey": { "type": "string", "minLength": 1 },
      "access": { "enum": ["shared-write", "exclusive-write"] }
    }
  }
}
