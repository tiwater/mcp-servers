{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.operation-derivation-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "derivationId",
    "requestId",
    "effectDescriptor",
    "output",
    "targetCandidateId",
    "operation",
    "resourceSet",
    "writeSet",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "tiwater.operation-derivation-result/v1" },
    "derivationId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "effectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "descriptorSha256"],
      "properties": {
        "identity": { "$ref": "#/$defs/Identity" },
        "descriptorSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputId", "artifactVersionId", "epochId"],
      "properties": {
        "outputId": { "type": "string", "minLength": 1 },
        "artifactVersionId": { "type": "string", "minLength": 1 },
        "epochId": { "type": "string", "minLength": 1 }
      }
    },
    "targetCandidateId": { "type": "string", "minLength": 1 },
    "operation": { "$ref": "#/$defs/TypedValue" },
    "resourceSet": { "$ref": "#/$defs/TypedValue" },
    "writeSet": { "$ref": "#/$defs/TypedValue" },
    "provenance": { "$ref": "#/$defs/TypedValue" }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value", "sha256"],
      "properties": {
        "schema": { "$ref": "#/$defs/SchemaRef" },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    }
  }
}
