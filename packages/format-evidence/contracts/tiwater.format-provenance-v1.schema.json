{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.format-provenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "artifactVersionId",
    "sourceBytesSha256",
    "inspectionSha256",
    "provider",
    "runtime",
    "extractionSha256"
  ],
  "properties": {
    "kind": { "const": "provider-inspection" },
    "artifactVersionId": { "type": "string", "minLength": 1 },
    "sourceBytesSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inspectionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": { "$ref": "#/$defs/Identity" },
    "runtime": { "$ref": "#/$defs/Identity" },
    "extractionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
