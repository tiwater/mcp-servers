{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.composed-effect/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effectId",
    "operationId",
    "planId",
    "closureDeclarationId",
    "effectIntentId",
    "outputId",
    "target",
    "effectDescriptor",
    "operation",
    "resourceSet",
    "writeSet",
    "topologicalIndex",
    "afterEffectIds",
    "authorities",
    "evidenceRefs"
  ],
  "properties": {
    "effectId": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "closureDeclarationId": {
      "type": "string",
      "minLength": 1
    },
    "effectIntentId": {
      "type": "string",
      "minLength": 1
    },
    "outputId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "targetAuthority",
            "artifactVersionId",
            "epochId",
            "targets"
          ],
          "properties": {
            "kind": {
              "const": "semantic-target"
            },
            "targetAuthority": {
              "$ref": "#/$defs/NodeRef"
            },
            "artifactVersionId": {
              "type": "string",
              "minLength": 1
            },
            "epochId": {
              "type": "string",
              "minLength": 1
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "targetId",
                  "candidateId",
                  "locator",
                  "resourceSet",
                  "writeSet"
                ],
                "properties": {
                  "targetId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "candidateId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "$ref": "#/$defs/TypedValue"
                  },
                  "resourceSet": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/TypedValue"
                    }
                  },
                  "writeSet": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/TypedValue"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "deliveryAuthority",
            "outputInitialization"
          ],
          "properties": {
            "kind": {
              "const": "delivery-output"
            },
            "deliveryAuthority": {
              "$ref": "#/$defs/NodeRef"
            },
            "outputInitialization": {
              "$ref": "#/$defs/TypedValue"
            }
          }
        }
      ]
    },
    "effectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectType",
        "descriptorSha256",
        "operationSchema",
        "executionAdapter"
      ],
      "properties": {
        "effectType": {
          "type": "string",
          "minLength": 1
        },
        "descriptorSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operationSchema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "executionAdapter": {
          "$ref": "#/$defs/Identity"
        }
      }
    },
    "operation": {
      "$ref": "#/$defs/TypedValue"
    },
    "resourceSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypedValue"
      }
    },
    "writeSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypedValue"
      }
    },
    "topologicalIndex": {
      "type": "integer",
      "minimum": 0
    },
    "afterEffectIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationPlan",
        "operationPlanVerdict"
      ],
      "properties": {
        "operationPlan": {
          "$ref": "#/$defs/NodeRef"
        },
        "operationPlanVerdict": {
          "$ref": "#/$defs/NodeRef"
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "contract",
        "sha256"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/SchemaRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "subjectSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authority",
            "producer",
            "validator",
            "runtime",
            "readback",
            "receipt"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "subjectSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
