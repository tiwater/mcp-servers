{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.provider-contract-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "effectType", "contracts", "ports", "executionAdapter", "manifestSha256"],
  "properties": {
    "schema": { "const": "tiwater.provider-contract-manifest/v1" },
    "provider": { "$ref": "#/$defs/identity" },
    "effectType": { "$ref": "#/$defs/identity" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "schema"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "schema": { "$ref": "#/$defs/schemaRef" }
        }
      }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "producer", "validator"],
        "properties": {
          "role": { "enum": ["format-observation", "operation-derivation", "effect-execution"] },
          "producer": { "$ref": "#/$defs/port" },
          "validator": { "$ref": "#/$defs/port" }
        }
      }
    },
    "executionAdapter": { "$ref": "#/$defs/identity" },
    "manifestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
