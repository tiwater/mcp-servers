{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.execution-evidence-verdict/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "evidence",
    "validator",
    "recomputedRequestSha256",
    "recomputedReceiptSha256",
    "recomputedLineageSha256",
    "decision",
    "findings"
  ],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/ArtifactRef" },
    "validator": { "$ref": "#/$defs/Identity" },
    "recomputedRequestSha256": { "$ref": "#/$defs/Sha256" },
    "recomputedReceiptSha256": { "$ref": "#/$defs/Sha256" },
    "recomputedLineageSha256": { "$ref": "#/$defs/Sha256" },
    "decision": { "enum": ["pass", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "path", "sha256"],
      "properties": {
        "schema": { "$ref": "#/$defs/SchemaRef" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    }
  }
}
