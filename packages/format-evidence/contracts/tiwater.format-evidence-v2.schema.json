{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.format-evidence/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceId",
    "requestId",
    "subject",
    "artifactVersionId",
    "source",
    "format",
    "provider",
    "runtime",
    "extractionSha256",
    "observation",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tiwater.format-evidence/v2"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inputId"
          ],
          "properties": {
            "kind": {
              "const": "input"
            },
            "inputId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outputId"
          ],
          "properties": {
            "kind": {
              "const": "output"
            },
            "outputId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "artifactVersionId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytesSha256",
        "mediaType"
      ],
      "properties": {
        "bytesSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "format": {
      "enum": [
        "docx",
        "xlsx",
        "xls",
        "pptx",
        "pdf",
        "txt"
      ]
    },
    "provider": {
      "$ref": "#/$defs/Identity"
    },
    "runtime": {
      "$ref": "#/$defs/Identity"
    },
    "extractionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation": {
      "$ref": "#/$defs/TypedValue"
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypedValue"
      }
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
