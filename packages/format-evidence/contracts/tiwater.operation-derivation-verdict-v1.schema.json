{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.operation-derivation-verdict/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "result",
    "validator",
    "recomputedOperationSha256",
    "recomputedResourceSetSha256",
    "recomputedWriteSetSha256",
    "recomputedProvenanceSha256",
    "decision",
    "findings"
  ],
  "properties": {
    "schema": { "const": "tiwater.operation-derivation-verdict/v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "result": { "$ref": "#/$defs/EvidenceRef" },
    "validator": { "$ref": "#/$defs/Identity" },
    "recomputedOperationSha256": { "$ref": "#/$defs/Sha256" },
    "recomputedResourceSetSha256": { "$ref": "#/$defs/Sha256" },
    "recomputedWriteSetSha256": { "$ref": "#/$defs/Sha256" },
    "recomputedProvenanceSha256": { "$ref": "#/$defs/Sha256" },
    "decision": { "enum": ["pass", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": { "$ref": "#/$defs/SchemaRef" },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    }
  }
}
