{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.execution-evidence/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effectId",
    "outputId",
    "mode",
    "request",
    "receipt",
    "inputArtifact",
    "outputArtifact",
    "inputEpochId",
    "outputEpochId",
    "lineage",
    "status",
    "evidenceRefs"
  ],
  "properties": {
    "effectId": {
      "type": "string",
      "minLength": 1
    },
    "outputId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "materialization",
        "mutation"
      ]
    },
    "request": {
      "$ref": "#/$defs/TypedValue"
    },
    "receipt": {
      "$ref": "#/$defs/TypedValue"
    },
    "inputArtifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputArtifact": {
      "$ref": "#/$defs/BlobRef"
    },
    "inputEpochId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outputEpochId": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "$ref": "#/$defs/TypedValue"
    },
    "status": {
      "enum": [
        "applied",
        "failed",
        "blocked"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    }
  },
  "$defs": {
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "BlobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactVersionId",
        "path",
        "bytesSha256",
        "mediaType"
      ],
      "properties": {
        "artifactVersionId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytesSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "subjectSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authority",
            "producer",
            "validator",
            "runtime",
            "readback",
            "receipt"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "subjectSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
