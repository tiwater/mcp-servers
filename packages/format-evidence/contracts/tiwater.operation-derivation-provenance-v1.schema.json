{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.operation-derivation-provenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestSha256",
    "effectDescriptorSha256",
    "targetCandidateId",
    "targetLocatorSha256",
    "sourceFactSha256",
    "effectIntentSha256",
    "bindingAuthoritySha256",
    "operationSha256",
    "resourceSetSha256",
    "writeSetSha256",
    "provider"
  ],
  "properties": {
    "requestSha256": { "$ref": "#/$defs/Sha256" },
    "effectDescriptorSha256": { "$ref": "#/$defs/Sha256" },
    "targetCandidateId": { "type": "string", "minLength": 1 },
    "targetLocatorSha256": { "$ref": "#/$defs/Sha256" },
    "sourceFactSha256": { "$ref": "#/$defs/Sha256" },
    "effectIntentSha256": { "$ref": "#/$defs/Sha256" },
    "bindingAuthoritySha256": { "$ref": "#/$defs/Sha256" },
    "operationSha256": { "$ref": "#/$defs/Sha256" },
    "resourceSetSha256": { "$ref": "#/$defs/Sha256" },
    "writeSetSha256": { "$ref": "#/$defs/Sha256" },
    "provider": { "$ref": "#/$defs/Identity" }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
