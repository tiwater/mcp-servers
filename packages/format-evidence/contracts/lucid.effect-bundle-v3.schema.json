{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.effect-bundle/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effects",
    "resourceSet",
    "writeSet",
    "conflictVerdict",
    "bundleSha256"
  ],
  "properties": {
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypedValue"
      }
    },
    "resourceSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypedValue"
      }
    },
    "writeSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypedValue"
      }
    },
    "conflictVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "findings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pass",
            "failed"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypedValue"
          }
        }
      }
    },
    "bundleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
