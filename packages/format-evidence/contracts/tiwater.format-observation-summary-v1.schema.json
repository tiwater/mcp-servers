{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.format-observation-summary/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "inspectionSha256", "facets"],
  "properties": {
    "format": {
      "enum": ["docx", "xlsx", "xls", "pptx", "pdf", "txt"]
    },
    "inspectionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["facetId", "sha256"],
        "properties": {
          "facetId": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
