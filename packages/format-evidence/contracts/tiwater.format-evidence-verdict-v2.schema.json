{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.format-evidence-verdict/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "subject",
    "artifactVersionId",
    "evidence",
    "validator",
    "recomputedSourceBytesSha256",
    "recomputedObservationSha256",
    "recomputedProvenanceSha256",
    "decision",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "tiwater.format-evidence-verdict/v2"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inputId"
          ],
          "properties": {
            "kind": {
              "const": "input"
            },
            "inputId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outputId"
          ],
          "properties": {
            "kind": {
              "const": "output"
            },
            "outputId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "artifactVersionId": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sha256"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validator": {
      "$ref": "#/$defs/Identity"
    },
    "recomputedSourceBytesSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recomputedObservationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recomputedProvenanceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "pass",
        "failed"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
