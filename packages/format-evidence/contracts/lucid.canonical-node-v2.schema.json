{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.canonical-node/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "nodeId",
    "contract",
    "dependsOn",
    "authorityRefs",
    "producer",
    "payload",
    "payloadSha256",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "lucid.canonical-node/v2"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "$ref": "#/$defs/SchemaRef"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodeRef"
      }
    },
    "authorityRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "payload": {
      "$comment": "Validated against the registered schema at sibling:contract.",
      "x-lucid-dynamic-schema-ref": "sibling:contract"
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "contract",
        "sha256"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/SchemaRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "subjectSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authority",
            "producer",
            "validator",
            "runtime",
            "readback",
            "receipt"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "subjectSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "adapter",
        "registrySha256"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/Identity"
        },
        "adapter": {
          "$ref": "#/$defs/Identity"
        },
        "registrySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "verdictImpact",
        "refs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "verdictImpact": {
          "enum": [
            "none",
            "non-pass"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
