{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.provider-effect-intent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["effectId", "effectType", "operationKind", "arguments"],
  "properties": {
    "effectId": { "type": "string", "minLength": 1 },
    "effectType": { "$ref": "#/$defs/Identity" },
    "operationKind": { "type": "string", "minLength": 1 },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "$ref": "#/$defs/TypedValue" }
        }
      }
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value", "sha256"],
      "properties": {
        "schema": { "$ref": "#/$defs/SchemaRef" },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    }
  }
}
