{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.format-evidence-request/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "runId",
    "subject",
    "artifact",
    "provider",
    "validator",
    "runtime",
    "extraction",
    "expectedEvidenceContract"
  ],
  "properties": {
    "schema": {
      "const": "tiwater.format-evidence-request/v2"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inputId"
          ],
          "properties": {
            "kind": {
              "const": "input"
            },
            "inputId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outputId"
          ],
          "properties": {
            "kind": {
              "const": "output"
            },
            "outputId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "artifact": {
      "$ref": "#/$defs/BlobRef"
    },
    "provider": {
      "$ref": "#/$defs/Identity"
    },
    "validator": {
      "$ref": "#/$defs/Identity"
    },
    "runtime": {
      "$ref": "#/$defs/Identity"
    },
    "extraction": {
      "$ref": "#/$defs/TypedValue"
    },
    "expectedEvidenceContract": {
      "$ref": "#/$defs/SchemaRef"
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "BlobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactVersionId",
        "path",
        "bytesSha256",
        "mediaType"
      ],
      "properties": {
        "artifactVersionId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytesSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
