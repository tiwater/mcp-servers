{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.provider-document-observation/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "artifactVersionId",
    "epochId",
    "inspectionSha256",
    "facets",
    "inventoryUniverse",
    "targetUniverse"
  ],
  "properties": {
    "format": { "$ref": "#/$defs/Format" },
    "artifactVersionId": { "type": "string", "minLength": 1 },
    "epochId": { "type": "string", "minLength": 1 },
    "inspectionSha256": { "$ref": "#/$defs/Sha256" },
    "facets": {
      "type": "array",
      "items": { "$ref": "#/$defs/Facet" }
    },
    "inventoryUniverse": { "$ref": "#/$defs/InventoryUniverse" },
    "targetUniverse": { "$ref": "#/$defs/TargetUniverse" }
  },
  "$defs": {
    "Format": {
      "enum": ["docx", "xlsx", "xls", "pptx", "pdf", "txt"]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value", "sha256"],
      "properties": {
        "schema": { "$ref": "#/$defs/SchemaRef" },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "Facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facetId", "sha256"],
      "properties": {
        "facetId": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ScalarField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "value", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["string", "number", "boolean", "null"] },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "InventoryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateKind",
        "pointer",
        "fields",
        "candidateValueSha256",
        "dispositionInput"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "candidateKind": { "enum": ["object", "array", "scalar"] },
        "pointer": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScalarField" }
        },
        "candidateValueSha256": { "$ref": "#/$defs/Sha256" },
        "dispositionInput": { "const": "available" }
      }
    },
    "InventoryUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universeId",
        "artifactVersionId",
        "inspectionSha256",
        "candidates",
        "universeSha256"
      ],
      "properties": {
        "universeId": { "type": "string", "minLength": 1 },
        "artifactVersionId": { "type": "string", "minLength": 1 },
        "inspectionSha256": { "$ref": "#/$defs/Sha256" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/InventoryCandidate" }
        },
        "universeSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ResourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKey", "access"],
      "properties": {
        "resourceKey": { "type": "string", "minLength": 1 },
        "access": { "enum": ["shared-write", "exclusive-write"] }
      }
    },
    "WriteDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKey", "writeKey"],
      "properties": {
        "resourceKey": { "type": "string", "minLength": 1 },
        "writeKey": { "type": "string" }
      }
    },
    "TargetCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "artifactVersionId",
        "epochId",
        "semanticIdentity",
        "locator",
        "capabilities",
        "supportedOperationKinds",
        "resourceDeclarations",
        "writeDeclarations",
        "candidateValueSha256",
        "inspectionSha256"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "artifactVersionId": { "type": "string", "minLength": 1 },
        "epochId": { "type": "string", "minLength": 1 },
        "semanticIdentity": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScalarField" }
        },
        "locator": { "$ref": "#/$defs/TypedValue" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Identity" }
        },
        "supportedOperationKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resourceDeclarations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ResourceDeclaration" }
        },
        "writeDeclarations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/WriteDeclaration" }
        },
        "candidateValueSha256": { "$ref": "#/$defs/Sha256" },
        "inspectionSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TargetUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universeId",
        "artifactVersionId",
        "epochId",
        "inspectionSha256",
        "candidates",
        "universeSha256"
      ],
      "properties": {
        "universeId": { "type": "string", "minLength": 1 },
        "artifactVersionId": { "type": "string", "minLength": 1 },
        "epochId": { "type": "string", "minLength": 1 },
        "inspectionSha256": { "$ref": "#/$defs/Sha256" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/TargetCandidate" }
        },
        "universeSha256": { "$ref": "#/$defs/Sha256" }
      }
    }
  }
}
