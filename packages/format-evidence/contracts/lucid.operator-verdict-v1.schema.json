{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.operator-verdict/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "decision",
    "recomputedPayloadSha256",
    "recomputedAuthoritySetSha256",
    "findings",
    "evidenceRefs"
  ],
  "properties": {
    "subject": {
      "$ref": "#/$defs/NodeRef"
    },
    "decision": {
      "enum": [
        "pass",
        "review-required",
        "blocked",
        "failed"
      ]
    },
    "recomputedPayloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recomputedAuthoritySetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "evidenceRefs"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/EvidenceRef"
            }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      }
    }
  },
  "$defs": {
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "contract",
        "sha256"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/SchemaRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "subjectSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authority",
            "producer",
            "validator",
            "runtime",
            "readback",
            "receipt"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "subjectSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
