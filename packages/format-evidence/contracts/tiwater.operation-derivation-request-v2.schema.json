{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.operation-derivation-request/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "runId",
    "effectIntentId",
    "bindingId",
    "closureAuthority",
    "bindingAuthority",
    "normalizedFactsAuthority",
    "effectDescriptor",
    "output",
    "targetArtifact",
    "observation",
    "target",
    "sourceFacts",
    "effectIntent",
    "provider",
    "expectedResultContract"
  ],
  "properties": {
    "schema": { "const": "tiwater.operation-derivation-request/v2" },
    "requestId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "effectIntentId": { "type": "string", "minLength": 1 },
    "bindingId": { "type": "string", "minLength": 1 },
    "closureAuthority": { "$ref": "#/$defs/NodeRef" },
    "bindingAuthority": { "$ref": "#/$defs/NodeRef" },
    "normalizedFactsAuthority": { "$ref": "#/$defs/NodeRef" },
    "effectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "descriptorSha256",
        "operationSchema",
        "resourceSetSchema",
        "writeSetSchema",
        "targetScope",
        "executionAdapter"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/Identity" },
        "descriptorSha256": { "$ref": "#/$defs/Sha256" },
        "operationSchema": { "$ref": "#/$defs/SchemaRef" },
        "resourceSetSchema": { "$ref": "#/$defs/SchemaRef" },
        "writeSetSchema": { "$ref": "#/$defs/SchemaRef" },
        "targetScope": { "enum": ["current-artifact", "external-artifact"] },
        "executionAdapter": { "$ref": "#/$defs/Identity" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputId", "artifact", "epochId", "format"],
      "properties": {
        "outputId": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/ArtifactAuthority" },
        "epochId": { "type": "string", "minLength": 1 },
        "format": { "enum": ["docx", "xlsx", "pptx"] }
      }
    },
    "targetArtifact": { "$ref": "#/$defs/ArtifactAuthority" },
    "observation": { "$ref": "#/$defs/TypedValue" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAuthority",
        "targetId",
        "candidate",
        "resourceSet",
        "writeSet"
      ],
      "properties": {
        "targetAuthority": { "$ref": "#/$defs/NodeRef" },
        "targetId": { "type": "string", "minLength": 1 },
        "candidate": { "$ref": "#/$defs/TargetCandidate" },
        "resourceSet": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/TypedValue" }
        },
        "writeSet": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/TypedValue" }
        }
      }
    },
    "sourceFacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factId", "value"],
        "properties": {
          "factId": { "type": "string", "minLength": 1 },
          "value": { "$ref": "#/$defs/TypedValue" }
        }
      }
    },
    "effectIntent": { "$ref": "#/$defs/TypedValue" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "adapter", "runtime"],
      "properties": {
        "identity": { "$ref": "#/$defs/Identity" },
        "adapter": { "$ref": "#/$defs/Identity" },
        "runtime": { "$ref": "#/$defs/Identity" }
      }
    },
    "expectedResultContract": { "$ref": "#/$defs/SchemaRef" }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value", "sha256"],
      "properties": {
        "schema": { "$ref": "#/$defs/SchemaRef" },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "contract", "sha256"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "contract": { "$ref": "#/$defs/SchemaRef" },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ArtifactAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactVersionId", "path", "bytesSha256", "mediaType"],
      "properties": {
        "artifactVersionId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "bytesSha256": { "$ref": "#/$defs/Sha256" },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    },
    "TargetCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "artifactVersionId",
        "epochId",
        "semanticIdentity",
        "locator",
        "capabilities",
        "supportedOperationKinds",
        "resourceDeclarations",
        "writeDeclarations",
        "candidateValueSha256",
        "inspectionSha256"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "artifactVersionId": { "type": "string", "minLength": 1 },
        "epochId": { "type": "string", "minLength": 1 },
        "semanticIdentity": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScalarField" }
        },
        "locator": { "$ref": "#/$defs/TypedValue" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Identity" }
        },
        "supportedOperationKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resourceDeclarations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ResourceDeclaration" }
        },
        "writeDeclarations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/WriteDeclaration" }
        },
        "candidateValueSha256": { "$ref": "#/$defs/Sha256" },
        "inspectionSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ResourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKey", "access"],
      "properties": {
        "resourceKey": { "type": "string", "minLength": 1 },
        "access": { "enum": ["shared-write", "exclusive-write"] }
      }
    },
    "WriteDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKey", "writeKey"],
      "properties": {
        "resourceKey": { "type": "string", "minLength": 1 },
        "writeKey": { "type": "string" }
      }
    },
    "ScalarField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "value", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["string", "number", "boolean", "null"] },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    }
  }
}
