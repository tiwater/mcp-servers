{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lucid.effect-execution-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effectId",
    "effectBundleAuthority",
    "effectBundleVerdict",
    "effect",
    "providerRequest",
    "requestSha256"
  ],
  "properties": {
    "effectId": {
      "type": "string",
      "minLength": 1
    },
    "effectBundleAuthority": {
      "$ref": "#/$defs/NodeRef"
    },
    "effectBundleVerdict": {
      "$ref": "#/$defs/NodeRef"
    },
    "effect": {
      "$ref": "#/$defs/TypedValue"
    },
    "providerRequest": {
      "$ref": "#/$defs/TypedValue"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "SchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "NodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "contract",
        "sha256"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "#/$defs/SchemaRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value",
        "sha256"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaRef"
        },
        "value": {
          "$comment": "Validated against the registered schema at sibling:schema.",
          "x-lucid-dynamic-schema-ref": "sibling:schema"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
