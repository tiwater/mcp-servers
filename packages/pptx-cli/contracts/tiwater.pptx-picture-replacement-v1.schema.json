{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.pptx-picture-replacement/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["changes"],
  "properties": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideNumber", "shapeId", "image"],
        "properties": {
          "slideNumber": { "type": "integer", "minimum": 1 },
          "shapeId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "image": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
