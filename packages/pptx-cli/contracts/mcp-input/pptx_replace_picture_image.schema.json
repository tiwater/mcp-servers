{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the current PPTX."
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slideNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "shapeId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 4294967295
          },
          "image": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slideNumber",
          "shapeId",
          "image"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "New PPTX output path. Existing files are never overwritten."
    },
    "receiptOutput": {
      "type": "string",
      "minLength": 1,
      "description": "New JSON receipt path. Existing files are never overwritten."
    }
  },
  "required": [
    "input",
    "changes",
    "output",
    "receiptOutput"
  ],
  "additionalProperties": false
}
