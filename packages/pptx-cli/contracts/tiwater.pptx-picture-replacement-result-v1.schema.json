{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.pptx-picture-replacement-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output", "operationCount", "appliedCount", "changes", "issues"],
  "properties": {
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "operationCount": { "type": "integer", "minimum": 0 },
    "appliedCount": { "type": "integer", "minimum": 0 },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideNumber", "shapeId", "image", "beforeSha256", "afterSha256"],
        "properties": {
          "slideNumber": { "type": "integer", "minimum": 1 },
          "shapeId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "image": { "type": "string", "minLength": 1 },
          "beforeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "afterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideNumber", "shapeId", "message"],
        "properties": {
          "slideNumber": { "type": "integer" },
          "shapeId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
