{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.pptx-shape-geometry-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output", "operationCount", "appliedCount", "changes", "issues"],
  "properties": {
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "operationCount": { "type": "integer", "minimum": 0 },
    "appliedCount": { "type": "integer", "minimum": 0 },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideNumber", "shapeId", "before", "after"],
        "properties": {
          "slideNumber": { "type": "integer", "minimum": 1 },
          "shapeId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "before": { "$ref": "#/$defs/transform" },
          "after": { "$ref": "#/$defs/transform" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideNumber", "shapeId", "message"],
        "properties": {
          "slideNumber": { "type": "integer" },
          "shapeId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "cx", "cy"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
