{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.pptx-template-apply-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "template", "output", "changedSlideCount", "issues"],
  "properties": {
    "input": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "changedSlideCount": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideNumber", "message"],
        "properties": {
          "slideNumber": { "type": ["integer", "null"], "minimum": 1 },
          "message": { "type": "string" }
        }
      }
    }
  }
}
