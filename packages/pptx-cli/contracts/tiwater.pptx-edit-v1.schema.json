{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.pptx-edit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slideNumber",
          "shapeId",
          "runIndex",
          "fontFamily",
          "fontSize",
          "color",
          "bold",
          "paragraphAlignment"
        ],
        "properties": {
          "slideNumber": { "type": "integer", "minimum": 1 },
          "shapeId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "runIndex": { "type": "integer", "minimum": 0 },
          "fontFamily": { "type": ["string", "null"] },
          "fontSize": { "type": ["number", "null"] },
          "color": { "type": ["string", "null"] },
          "bold": { "type": ["boolean", "null"] },
          "paragraphAlignment": { "type": ["string", "null"] }
        }
      }
    }
  }
}
