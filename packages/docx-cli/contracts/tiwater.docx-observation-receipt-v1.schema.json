{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "tiwater.docx-observation-receipt/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "operation", "totalCount", "returnedCount", "remaining", "nextOffset"],
  "properties": {
    "schema": { "const": "tiwater.docx-observation-receipt/v1" }, "operation": { "enum": ["list", "find", "read"] },
    "totalCount": { "type": "integer", "minimum": 0 }, "returnedCount": { "type": "integer", "minimum": 0 },
    "remaining": { "type": "integer", "minimum": 0 }, "nextOffset": { "type": ["integer", "null"], "minimum": 0 }
  }
}
