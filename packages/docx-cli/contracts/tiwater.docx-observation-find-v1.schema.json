{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.docx-observation-find/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt", "matches"],
  "properties": {
    "schema": { "const": "tiwater.docx-observation-find/v1" },
    "receipt": { "$ref": "#/$defs/receipt" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "matches"],
        "properties": {
          "object": { "$ref": "#/$defs/object" },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "length"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0 },
                "length": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "properties": {
        "part": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" }
      },
      "required": ["part", "path"],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "totalCount", "returnedCount", "remaining", "nextOffset"],
      "properties": {
        "schema": { "const": "tiwater.docx-observation-receipt/v1" },
        "operation": { "const": "find" },
        "totalCount": { "type": "integer", "minimum": 0 },
        "returnedCount": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 },
        "nextOffset": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "parentAddress", "kind", "localName", "textPreview", "textLength", "childCount", "gridSpan", "verticalMerge"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "parentAddress": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
        "kind": { "enum": ["part", "paragraph", "table", "gridColumn", "row", "cell", "run", "text", "drawing"] },
        "localName": { "type": "string", "minLength": 1 },
        "textPreview": { "type": ["string", "null"] },
        "textLength": { "type": ["integer", "null"], "minimum": 0 },
        "childCount": { "type": "integer", "minimum": 0 },
        "gridSpan": { "type": ["integer", "null"], "minimum": 1 },
        "verticalMerge": { "type": ["string", "null"] }
      }
    }
  }
}
