{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "New document output path. Existing files are never overwritten."
    },
    "receiptOutput": {
      "type": "string",
      "minLength": 1,
      "description": "New JSON receipt path. Existing files are never overwritten."
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tableIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rowIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cellIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "richText": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "underline": {
                  "type": "boolean"
                },
                "bold": {
                  "type": "boolean"
                },
                "fontName": {
                  "type": "string"
                },
                "italic": {
                  "type": "boolean"
                },
                "verticalAlignment": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "superscript",
                    "subscript"
                  ]
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "tableIndex",
          "rowIndex",
          "cellIndex",
          "richText"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "input",
    "output",
    "receiptOutput",
    "changes"
  ],
  "additionalProperties": false
}
