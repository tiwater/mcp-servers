{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "New document output path. Existing files are never overwritten."
    },
    "receiptOutput": {
      "type": "string",
      "minLength": 1,
      "description": "New JSON receipt path. Existing files are never overwritten."
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tableIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "width": {
            "type": "string",
            "minLength": 1
          },
          "widthType": {
            "type": "string",
            "enum": [
              "pct",
              "dxa",
              "auto",
              "nil"
            ]
          }
        },
        "required": [
          "tableIndex",
          "width",
          "widthType"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "input",
    "output",
    "receiptOutput",
    "changes"
  ],
  "additionalProperties": false
}
