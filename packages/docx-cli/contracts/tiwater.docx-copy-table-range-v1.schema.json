{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.docx-copy-table-range/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "target", "columns", "output", "receiptOutput"],
  "properties": {
    "schema": { "const": "tiwater.docx-copy-table-range/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "revision", "rowRefs"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revisionId" },
        "rowRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objectRef" } }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "revision", "tableRef", "rowPatternRefs"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revisionId" },
        "tableRef": { "$ref": "#/$defs/objectRef" },
        "rowPatternRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objectRef" } }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceGridColumn", "targetGridColumn"],
        "properties": {
          "sourceGridColumn": { "type": "integer", "minimum": 0 },
          "targetGridColumn": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "output": { "type": "string", "minLength": 1 },
    "receiptOutput": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "revisionId": { "type": "string", "pattern": "^docx-rev-v1-[0-9a-f]{64}$" },
    "objectRef": { "type": "string", "pattern": "^dox1_[0-9a-f]{64}$" }
  }
}
