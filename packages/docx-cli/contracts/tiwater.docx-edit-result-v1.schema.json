{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.docx-edit-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output", "appliedOperations"],
  "properties": {
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "appliedOperations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "applied", "detail"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "applied": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
