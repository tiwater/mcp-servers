{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.docx-copy-table-range-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "toolVersion", "sourceRevision", "targetRevision", "outputRevision", "sourceRowCount", "targetPatternRowCount", "columnMappingCount", "outputRows", "output"],
  "properties": {
    "schema": { "const": "tiwater.docx-copy-table-range-receipt/v1" },
    "provider": { "const": "tiwater.docx.cli" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "targetRevision": { "$ref": "#/$defs/revision" },
    "outputRevision": { "$ref": "#/$defs/revision" },
    "sourceRowCount": { "type": "integer", "minimum": 1 },
    "targetPatternRowCount": { "type": "integer", "minimum": 1 },
    "columnMappingCount": { "type": "integer", "minimum": 1 },
    "outputRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "nativePath", "values"],
        "properties": {
          "ref": { "type": "string", "pattern": "^dox1_[0-9a-f]{64}$" },
          "nativePath": { "type": "string", "pattern": "^/[^\\s]+$" },
          "values": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "output": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputSha256", "provider", "toolVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^docx-rev-v1-[0-9a-f]{64}$" },
        "inputSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "provider": { "const": "tiwater.docx.cli" },
        "toolVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
