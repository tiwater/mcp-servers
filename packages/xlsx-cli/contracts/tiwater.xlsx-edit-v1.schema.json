{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.xlsx-edit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "setCellValue",
              "setCellNumberFormat",
              "setPrintArea",
              "setPageSetup",
              "setRowPageBreaks",
              "setColumnWidth",
              "setRichTextCellValue",
              "setRangeValues",
              "insertRows",
              "copyRow",
              "expandSectionRows"
            ]
          },
          "sheet": { "type": ["string", "null"] },
          "cell": { "type": ["string", "null"] },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "valueType": { "type": ["string", "null"] },
          "numberFormat": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
          "sourceSheet": { "type": ["string", "null"], "minLength": 1 },
          "sourceCell": { "type": ["string", "null"], "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$" },
          "startCell": { "type": ["string", "null"] },
          "values": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            ]
          },
          "bold": { "type": ["boolean", "null"] },
          "shrinkToFit": { "type": ["boolean", "null"] },
          "wrapText": { "type": ["boolean", "null"] },
          "startRow": { "type": ["integer", "null"], "minimum": 1 },
          "count": { "type": ["integer", "null"], "minimum": 1 },
          "sourceRow": { "type": ["integer", "null"], "minimum": 1 },
          "targetRow": { "type": ["integer", "null"], "minimum": 1 },
          "translateFormulas": { "type": ["boolean", "null"] },
          "anchorText": { "type": ["string", "null"] },
          "exampleRows": { "type": ["integer", "null"], "minimum": 1 },
          "targetRows": { "type": ["integer", "null"], "minimum": 1 },
          "preserveStyle": { "type": ["boolean", "null"] },
          "preserveFormulas": { "type": ["boolean", "null"] },
          "preserveMergedRanges": { "type": ["boolean", "null"] },
          "range": { "type": ["string", "null"] }
          ,
          "column": { "type": ["string", "null"], "pattern": "^[A-Za-z]{1,3}$" },
          "width": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 255 },
          "fitToPagesWide": { "type": ["integer", "null"], "minimum": 1, "maximum": 32767 },
          "fitToPagesTall": { "type": ["integer", "null"], "minimum": 1, "maximum": 32767 },
          "orientation": { "type": ["string", "null"], "enum": ["portrait", "landscape", null] },
          "paperSize": { "type": ["string", "null"], "enum": ["letter", "legal", "a3", "a4", null] },
          "repeatRowsStart": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
          "repeatRowsEnd": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
          "repeatColsStart": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
          "repeatColsEnd": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
          "breakBeforeRows": {
            "type": ["array", "null"],
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 2, "maximum": 1048576 }
          }
        },
        "dependentRequired": {
          "repeatRowsStart": ["repeatRowsEnd"],
          "repeatRowsEnd": ["repeatRowsStart"],
          "repeatColsStart": ["repeatColsEnd"],
          "repeatColsEnd": ["repeatColsStart"]
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "setCellNumberFormat" } }, "required": ["type"] },
            "then": {
              "required": ["sheet", "cell"],
              "oneOf": [
                {
                  "required": ["numberFormat"],
                  "properties": { "numberFormat": { "type": "string", "minLength": 1, "maxLength": 255 } },
                  "not": { "anyOf": [{ "required": ["sourceSheet"] }, { "required": ["sourceCell"] }] }
                },
                {
                  "required": ["sourceSheet", "sourceCell"],
                  "properties": {
                    "sourceSheet": { "type": "string", "minLength": 1 },
                    "sourceCell": { "type": "string", "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$" }
                  },
                  "not": { "required": ["numberFormat"] }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
