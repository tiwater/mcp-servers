{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiwater.com/xlsx/region-inventory/v1",
  "title": "Tiwater XLSX region inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "toolVersion", "file", "inputSha256", "sheets"],
  "properties": {
    "schema": { "const": "tiwater.xlsx.region-inventory/v1" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "file": { "type": "string", "minLength": 1 },
    "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/sheet" }
    }
  },
  "$defs": {
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "regions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "range", "startRow", "endRow", "rows"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[1-9][0-9]*-r[1-9][0-9]*$" },
        "range": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*:[A-Z]+[1-9][0-9]*$" },
        "startRow": { "type": "integer", "minimum": 1 },
        "endRow": { "type": "integer", "minimum": 1 },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "cells"],
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "row", "column", "columnName", "rawValue", "formattedValue", "formula"],
      "properties": {
        "reference": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$" },
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "columnName": { "type": "string", "pattern": "^[A-Z]+$" },
        "rawValue": { "type": "string" },
        "formattedValue": { "type": "string" },
        "formula": { "type": ["string", "null"] }
      }
    }
  }
}
