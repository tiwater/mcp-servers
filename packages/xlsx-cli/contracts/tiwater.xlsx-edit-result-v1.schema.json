{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.xlsx-edit-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output", "appliedOperations"],
  "properties": {
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "appliedOperations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "applied", "detail"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "applied": { "type": "boolean" },
          "detail": { "type": "string" },
          "sheet": { "type": ["string", "null"] },
          "changedRange": { "type": ["string", "null"] },
          "warnings": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "errorCode": { "type": ["string", "null"], "pattern": "^xlsx\\.", "minLength": 1 }
        }
      }
    }
  }
}
