<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tiwater-xlsx</ToolCommandName>
    <PackageId>tiwater.xlsx.cli</PackageId>
    <Version>0.2.26</Version>
    <Authors>Tiwater</Authors>
    <Description>Inspect XLSX templates, export workbook data, and fill spreadsheet templates from the command line.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tiwater/mcp-servers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tiwater/mcp-servers.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>xlsx;spreadsheet;openxml;excel;cli;tool;tiwater</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="xlsx-cli.tests" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="NPOI" Version="2.7.2" />
    <ProjectReference Include="../convert-cli/convert.csproj" />
    <Compile Include="../format-evidence/FormatEvidenceCommand.cs" Link="FormatEvidenceCommand.cs" />
    <Compile Include="../format-evidence/OperationDerivationCommand.cs" Link="OperationDerivationCommand.cs" />
    <Compile Include="../format-evidence/EffectExecutionCommand.cs" Link="EffectExecutionCommand.cs" />
    <Compile Include="../format-evidence/ProviderContractManifestCommand.cs" Link="ProviderContractManifestCommand.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="contracts/*.schema.json" Pack="true" PackagePath="contracts/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../format-evidence/contracts/*.schema.json" Link="contracts/%(Filename)%(Extension)" Pack="true" PackagePath="contracts/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
