{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.convert-render-result/v1",
  "description": "Closed render result binding the output PDF bytes and the ordered per-page artifacts, with a reference to the native render provenance when a WPS backend rendered the document. Page artifact identity is frozen: pages[i].sha256 is the lowercase hex SHA-256 over the UTF-8 bytes of the page fingerprint material and pages[i].size_bytes is the UTF-8 byte length of that material. The material is the '\\n'-joined sequence of the header lines 'w=<width:R>', 'h=<height:R>', 'rot=<rotation degrees integer>', then one line per letter in PdfPig extraction order 'L|<value>|<location.X:R>|<location.Y:R>|<width:R>|<height:R>|<pointSize:R>|<fontName or empty>', then one line per page image in PdfPig extraction order 'I|<lowercase hex SHA-256 of the raw image bytes>'. '<number:R>' formats a double with round-trip 'R' formatting under the invariant culture.",
  "type": "object",
  "required": ["schema", "request_id", "request_sha256", "format", "input", "output", "renderer", "runtime", "options", "page_count", "pages", "native_render_provenance", "provenance_sha256", "producer"],
  "properties": {
    "schema": { "const": "tiwater.convert-render-result/v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "request_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 over the UTF-8 bytes of the canonical serialization (ordinal key order) of the full render request."
    },
    "format": { "enum": ["docx", "xlsx", "xls", "pptx", "pdf"] },
    "input": { "$ref": "#/$defs/inputArtifact" },
    "output": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "media_type": { "const": "application/pdf" }
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "required": ["backend", "provider", "version"],
      "properties": {
        "backend": { "$ref": "#/$defs/backend" },
        "provider": { "const": "tiwater-convert" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["id", "version", "os_description", "os_architecture", "process_architecture", "framework_description"],
      "properties": {
        "id": { "const": "tiwater-convert" },
        "version": { "type": "string", "minLength": 1 },
        "os_description": { "type": "string", "minLength": 1 },
        "os_architecture": { "type": "string", "minLength": 1 },
        "process_architecture": { "type": "string", "minLength": 1 },
        "framework_description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "options": { "type": "object", "additionalProperties": false },
    "page_count": { "type": "integer", "minimum": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "sha256", "size_bytes"],
        "properties": {
          "page": { "type": "integer", "minimum": 1, "description": "1-based page number in output order." },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "native_render_provenance": {
      "type": ["object", "null"],
      "description": "Full tiwater.convert-native-render-provenance/v1 object for wps-* backends; null for libreoffice and passthrough backends."
    },
    "provenance_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 over the canonical serialization of native_render_provenance; null when no provenance is attached."
    },
    "producer": {
      "type": "object",
      "required": ["id", "version", "command"],
      "properties": {
        "id": { "const": "tiwater-convert-render-producer" },
        "version": { "type": "string", "minLength": 1 },
        "command": { "const": "render" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "backend": { "enum": ["wps-writer", "wps-spreadsheet", "wps-presentation", "libreoffice", "passthrough"] },
    "inputArtifact": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "artifact_version_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "artifact_version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
