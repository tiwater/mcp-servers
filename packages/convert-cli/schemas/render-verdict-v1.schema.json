{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.convert-render-verdict/v1",
  "description": "Closed independent render verdict. The validator recomputes every identity, byte hash, and the full ordered page closure from the current authority bytes; any verdict or decision self-attested by the producer is ignored.",
  "type": "object",
  "required": ["schema", "request_id", "request_sha256", "result", "validator", "recomputed", "decision", "findings"],
  "properties": {
    "schema": { "const": "tiwater.convert-render-verdict/v1" },
    "request_id": { "type": ["string", "null"] },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "result": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the validated render result file bytes." }
      },
      "additionalProperties": false
    },
    "validator": {
      "type": "object",
      "required": ["id", "version", "command"],
      "properties": {
        "id": { "const": "tiwater-convert-render-validator" },
        "version": { "type": "string", "minLength": 1 },
        "command": { "const": "validate-render-evidence" }
      },
      "additionalProperties": false
    },
    "recomputed": {
      "type": "object",
      "required": ["input_sha256", "output_sha256", "page_count", "pages_sha256", "provenance_sha256"],
      "properties": {
        "input_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "output_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "page_count": { "type": ["integer", "null"], "minimum": 1 },
        "pages_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 over the canonical serialization of the independently recomputed ordered page artifact array."
        },
        "provenance_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "decision": { "enum": ["pass", "failed"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "path"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "description": "JSON pointer of the rejected value inside the render result or request." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
