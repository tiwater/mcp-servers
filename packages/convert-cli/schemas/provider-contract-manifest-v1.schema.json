{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.convert-provider-contract-manifest/v1",
  "description": "Closed provider contract manifest binding every render contract schema byte hash, the render producer/validator command identities, and the runtime version of this package.",
  "type": "object",
  "required": ["schema", "provider", "contracts", "ports", "runtime", "manifest_sha256"],
  "properties": {
    "schema": { "const": "tiwater.convert-provider-contract-manifest/v1" },
    "provider": { "$ref": "#/$defs/identity" },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "schema_ref"],
        "properties": {
          "role": {
            "enum": ["render-request", "render-result", "render-verdict", "native-render-provenance", "provider-contract-manifest", "provider-contract-manifest-verdict"]
          },
          "schema_ref": {
            "type": "object",
            "required": ["id", "sha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the deployed schema file bytes for this contract role." }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "producer", "validator"],
        "properties": {
          "role": { "enum": ["render", "provider-contract-manifest"] },
          "producer": { "$ref": "#/$defs/command" },
          "validator": { "$ref": "#/$defs/command" }
        },
        "additionalProperties": false
      }
    },
    "runtime": { "$ref": "#/$defs/identity" },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 over the canonical serialization (ordinal key order) of the manifest without the manifest_sha256 field."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "tiwater-convert" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["id", "version", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
