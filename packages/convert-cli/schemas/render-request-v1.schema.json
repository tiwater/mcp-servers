{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.convert-render-request/v1",
  "description": "Closed render request binding the input artifact bytes and version, the required renderer backend, the producer runtime identity, and the expected result contract schema bytes. v1 declares an explicitly empty option set: any option key is rejected.",
  "type": "object",
  "required": ["schema", "request_id", "format", "input", "output", "renderer", "runtime", "target_format", "options", "result_contract"],
  "properties": {
    "schema": { "const": "tiwater.convert-render-request/v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "format": { "enum": ["docx", "xlsx", "xls", "pptx", "pdf"] },
    "input": { "$ref": "#/$defs/inputArtifact" },
    "output": { "$ref": "#/$defs/outputSpec" },
    "renderer": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": { "$ref": "#/$defs/backend" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "tiwater-convert" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "target_format": { "const": "pdf" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "description": "v1 supports no render options; the object must be empty."
    },
    "result_contract": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "tiwater.convert-render-result/v1" },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the deployed tiwater.convert-render-result/v1 schema file bytes."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "backend": {
      "enum": ["wps-writer", "wps-spreadsheet", "wps-presentation", "libreoffice", "passthrough"],
      "description": "wps-writer renders docx, wps-spreadsheet renders xlsx/xls, wps-presentation renders pptx, libreoffice renders docx/xlsx/xls/pptx, passthrough copies a pdf input to the output artifact."
    },
    "inputArtifact": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "artifact_version_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "Absolute path to the current input artifact." },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "artifact_version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outputSpec": {
      "type": "object",
      "required": ["path", "media_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "Absolute path of the PDF artifact to be rendered; the producer refuses to overwrite an existing file." },
        "media_type": { "const": "application/pdf" }
      },
      "additionalProperties": false
    }
  }
}
