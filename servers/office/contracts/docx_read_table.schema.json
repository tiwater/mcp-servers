{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tiwater.office-mcp-input/docx_read_table/v1",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "x-tiwater-file-role": "read"
    },
    "table": {
      "type": "object",
      "properties": {
        "part": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^\\/" }
      },
      "required": ["part", "path"],
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Maximum number of table rows requested in this response page. The provider may return fewer to keep the machine response bounded."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Zero-based row offset. Continue from receipt.nextOffset until it is null."
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "x-tiwater-file-role": "write"
    }
  },
  "required": ["input", "table", "output"],
  "additionalProperties": false
}
