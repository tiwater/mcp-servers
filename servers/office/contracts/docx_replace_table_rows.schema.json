{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "New document output path. Existing files are never overwritten."
    },
    "receiptOutput": {
      "type": "string",
      "minLength": 1,
      "description": "New JSON receipt path. Existing files are never overwritten."
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tableIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "startRowIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endRowIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "templateRowIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "gridSpan": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "vMerge": {
                    "type": "string"
                  },
                  "bold": {
                    "type": "boolean"
                  },
                  "header": {
                    "type": "boolean"
                  },
                  "shading": {
                    "type": "string"
                  },
                  "alignment": {
                    "type": "string"
                  },
                  "richText": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "color": {
                          "type": "string"
                        },
                        "underline": {
                          "type": "boolean"
                        },
                        "bold": {
                          "type": "boolean"
                        },
                        "fontName": {
                          "type": "string"
                        },
                        "italic": {
                          "type": "boolean"
                        },
                        "verticalAlignment": {
                          "type": "string",
                          "enum": [
                            "baseline",
                            "superscript",
                            "subscript"
                          ]
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "required": [
          "tableIndex",
          "startRowIndex",
          "endRowIndex",
          "rows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "input",
    "output",
    "receiptOutput",
    "changes"
  ],
  "additionalProperties": false
}
