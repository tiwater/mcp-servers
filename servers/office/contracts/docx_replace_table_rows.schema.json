{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "x-tiwater-file-role": "read"
    },
    "tables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceInput": {
            "type": "string",
            "minLength": 1,
            "x-tiwater-file-role": "read"
          },
          "sourceTable": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^\\/"
              }
            },
            "required": [
              "part",
              "path"
            ],
            "additionalProperties": false
          },
          "sourceRows": {
            "type": "object",
            "description": "Contiguous source data rows. The header row stays outside this range. The first and last row must enclose complete vertical-merge groups as reported by docx_read_table.",
            "properties": {
              "first": {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/"
                  }
                },
                "required": [
                  "part",
                  "path"
                ],
                "additionalProperties": false
              },
              "last": {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/"
                  }
                },
                "required": [
                  "part",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "first",
              "last"
            ],
            "additionalProperties": false
          },
          "targetTable": {
            "type": "object",
            "properties": {
              "part": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^\\/"
              }
            },
            "required": [
              "part",
              "path"
            ],
            "additionalProperties": false
          },
          "targetRows": {
            "type": "object",
            "description": "Contiguous target data rows to replace. The header row stays outside this range. Omit last to replace from first through the table's final row. An explicit first and last must enclose complete vertical-merge groups as reported by docx_read_table.",
            "properties": {
              "first": {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/"
                  }
                },
                "required": [
                  "part",
                  "path"
                ],
                "additionalProperties": false
              },
              "last": {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/"
                  }
                },
                "required": [
                  "part",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "first"
            ],
            "additionalProperties": false
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "description": "Source-to-target header-cell mappings. Source headers share one row, target headers share one row, both header rows stay outside the selected data rows, and each side covers its complete table grid.",
            "items": {
              "type": "object",
              "properties": {
                "sourceHeader": {
                  "type": "object",
                  "properties": {
                    "part": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^\\/"
                    }
                  },
                  "required": [
                    "part",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "targetHeader": {
                  "type": "object",
                  "properties": {
                    "part": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^\\/"
                    }
                  },
                  "required": [
                    "part",
                    "path"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "sourceHeader",
                "targetHeader"
              ],
              "additionalProperties": false
            }
          },
          "sourceCellContents": {
            "type": "array",
            "description": "Optional per-cell content selections. Omit this field to copy every paragraph from each mapped source cell.",
            "items": {
              "type": "object",
              "properties": {
                "sourceCell": {
                  "type": "object",
                  "properties": {
                    "part": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^\\/"
                    }
                  },
                  "required": [
                    "part",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "sourceSelections": {
                  "type": "array",
                  "description": "Content selections inside sourceCell. Each item is a selection object; put the observed OpenXML address in its required address field and add range only for a substring.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "address": {
                        "type": "object",
                        "description": "Observed paragraph, run, or text OpenXML address selected from sourceCell.",
                        "properties": {
                          "part": {
                            "type": "string",
                            "minLength": 1
                          },
                          "path": {
                            "type": "string",
                            "pattern": "^\\/"
                          }
                        },
                        "required": [
                          "part",
                          "path"
                        ],
                        "additionalProperties": false
                      },
                      "range": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "length": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "start",
                          "length"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "address"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sourceCell",
                "sourceSelections"
              ],
              "additionalProperties": false
            }
          },
          "sourceParagraphMode": {
            "type": "string",
            "const": "omit-paired-latin-prose",
            "description": "Optional deterministic text selection for every mapped source cell. omit-paired-latin-prose preserves Han content and standalone technical expressions while omitting adjacent Latin prose paragraphs and punctuation-delimited translation clauses. It cannot be combined with sourceCellContents."
          }
        },
        "required": [
          "sourceInput",
          "sourceTable",
          "sourceRows",
          "targetTable",
          "targetRows",
          "columns"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "Output DOCX path; may equal input for an atomic in-place update.",
      "x-tiwater-file-role": "write"
    },
    "receiptOutput": {
      "type": "string",
      "minLength": 1,
      "x-tiwater-file-role": "write",
      "x-tiwater-file-effect": false
    }
  },
  "required": [
    "input",
    "tables",
    "output",
    "receiptOutput"
  ],
  "additionalProperties": false,
  "$id": "tiwater.office-mcp-input/docx_replace_table_rows"
}
