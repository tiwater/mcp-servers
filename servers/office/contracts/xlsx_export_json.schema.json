{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "New JSON artifact path. Existing files are never overwritten."
    },
    "resolveMergedCells": {
      "description": "Resolve merged cells to project values.",
      "type": "boolean"
    }
  },
  "required": [
    "input",
    "output"
  ],
  "additionalProperties": false
}
