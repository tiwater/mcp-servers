{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "x-tiwater-file-role": "read"
    },
    "literal": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "part",
        "paragraph",
        "table",
        "gridColumn",
        "row",
        "cell",
        "run",
        "text",
        "drawing"
      ]
    },
    "scope": {
      "description": "Exact story-part URI such as /word/document.xml.",
      "type": "string",
      "minLength": 1
    },
    "parentRef": {
      "description": "Optional revision-bound parent object ref. Searches only its nearest published child objects, not every recursive descendant.",
      "type": "string",
      "pattern": "^dox1_[0-9a-f]{64}$"
    },
    "limit": {
      "description": "Maximum matches in this small page. Refine the literal or parentRef when more matches remain; do not raise the page size to extract the document.",
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "continuation": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path for a new JSON artifact containing this exact search page for later reuse.",
      "x-tiwater-file-role": "write"
    }
  },
  "required": [
    "input",
    "literal",
    "output"
  ],
  "additionalProperties": false,
  "$id": "tiwater.office-mcp-input/docx_find_literal/v1"
}
