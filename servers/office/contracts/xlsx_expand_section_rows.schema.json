{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "string",
      "minLength": 1,
      "x-tiwater-file-role": "read"
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "New document output path. Existing files are never overwritten.",
      "x-tiwater-file-role": "write"
    },
    "receiptOutput": {
      "type": "string",
      "minLength": 1,
      "description": "New JSON receipt path. Existing files are never overwritten.",
      "x-tiwater-file-role": "write"
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "anchorText": {
            "type": "string",
            "minLength": 1
          },
          "exampleRows": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "targetRows": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "preserveStyle": {
            "type": "boolean"
          },
          "preserveFormulas": {
            "type": "boolean"
          },
          "preserveMergedRanges": {
            "type": "boolean"
          }
        },
        "required": [
          "sheet",
          "anchorText",
          "exampleRows",
          "targetRows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "input",
    "output",
    "receiptOutput",
    "changes"
  ],
  "additionalProperties": false
}
